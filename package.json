{
  "name": "kollect-v2",
  "displayName": "Kollect v2",
  "version": "0.0.1",
  "description": "manga tracking",
  "author": "bradley",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.5",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@plasmohq/messaging": "^0.7.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.34.0",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router": "^7.13.2",
    "sonner": "^2.0.7",
    "svix": "^1.93.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.27",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "key": "$CRX_PUBLIC_KEY",
    "permissions": [
      "cookies",
      "storage",
      "contextMenus",
      "tabs",
      "activeTab",
      "identity"
    ],
    "host_permissions": [
      "http://localhost/*",
      "https://*.clerk.accounts.dev/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/auth.html"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "icons": {
      "16": "./gen-assets/icon16.plasmo.png",
      "32": "./gen-assets/icon32.plasmo.png",
      "48": "./gen-assets/icon48.plasmo.png",
      "128": "./gen-assets/icon128.plasmo.png"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "Kollect: Manga Tracker",
      "default_icon": {
        "16": "./gen-assets/icon16.plasmo.png",
        "32": "./gen-assets/icon32.plasmo.png"
      }
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "bradley-kollect@addons.mozilla.org",
        "data_collection_permissions": {
          "required": [
            "none"
          ],
          "optional": []
        }
      }
    }
  }
}
